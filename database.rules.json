{
  "rules": {
    "devices": {
      ".indexOn": ["owner"],
      ".read": "auth != null && query.orderByChild === 'owner' && query.equalTo === auth.uid",
      "$deviceId": {
        ".read": "auth != null && data.child('owner').val() === auth.uid",
        ".write": "auth != null && (data.exists() ? data.child('owner').val() === auth.uid : newData.child('owner').val() === auth.uid)",
        ".validate": "$deviceId.length > 0 && $deviceId.length <= 64 && newData.hasChildren(['owner', 'type'])",
        "owner": { ".validate": "newData.val() === auth.uid" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "location": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "type": { ".validate": "newData.isString()" },
        "readings": {
          "$timestamp": {
            ".validate": "newData.hasChildren(['temperature', 'humidity', 'pressure'])"
          }
        },
        "alerts": {
          "$metric": {
            ".validate": "$metric === 'temperature' || $metric === 'humidity' || $metric === 'pressure' || $metric === 'offline'",
            "enabled": { ".validate": "newData.isBoolean()" },
            "min": { ".validate": "newData.isNumber()" },
            "max": { ".validate": "newData.isNumber()" },
            "minutes": { ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 1440" },
            "$other": { ".validate": false }
          }
        },
        "alertState": {
          "$key": { ".validate": "newData.isString() || newData.isBoolean()" }
        },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "fcmTokens": {
          "$token": { ".validate": "newData.val() === true" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
